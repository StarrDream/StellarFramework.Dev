# Track only Unity project source/config folders.
/*
!/.gitignore
!/AGENTS.md
!/README_EN.md
!/VERSIONING.md

!/Assets/
!/Assets/**

/Assets/PayloadInspect*
__pycache__/

!/ProjectSettings/
!/ProjectSettings/**

!/Packages/
!/Packages/**

!/.github/
!/.github/**

# Portable Codex skills for projects consuming StellarFramework.
!/.agents/
!/.agents/skills/
!/.agents/skills/stellarframework-unity/
!/.agents/skills/stellarframework-unity/**

# Project-local verification automation is source-controlled; generated run artifacts are not.
!/Tools/
!/Tools/AndroidVerification/
!/Tools/AndroidVerification/**
/Tools/AndroidVerification/Results/
